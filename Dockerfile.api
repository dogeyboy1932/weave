# Production image. Two build modes selected by EMBEDDING_RUNTIME:
#   --build-arg EMBEDDING_RUNTIME=pytorch  (default; ships SciNCL via torch CPU)
#   --build-arg EMBEDDING_RUNTIME=onnx     (ships models/ ONNX bundle, no torch)
# The ONNX path drops PyTorch + sentence-transformers from the image (~700 MB →
# ~150 MB) once you've run scripts/export_scincl_onnx.py and committed
# models/scincl-int8.onnx + tokenizer + MANIFEST.json.
#
# Run maintenance ops via:
#   flyctl ssh console --app <app>
#   cd /app && python scripts/<script>.py

FROM python:3.12-slim

ARG EMBEDDING_RUNTIME=pytorch
ENV EMBEDDING_RUNTIME=${EMBEDDING_RUNTIME}

# System deps: libpq for psycopg2, libgomp for torch CPU's OpenMP (no-op for ONNX).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# In pytorch mode, install CPU-only torch first so sentence-transformers
# doesn't pull the 2 GB CUDA build. In onnx mode, skip torch entirely.
RUN pip install --no-cache-dir --upgrade pip \
 && if [ "$EMBEDDING_RUNTIME" = "pytorch" ]; then \
        # x86_64: pull the slim CPU-only wheel from PyTorch's cpu index.
        # aarch64 (Oracle Ampere / any ARM host): that index has no arm wheels,
        # and the default PyPI torch build is already CPU-only on arm — use it.
        if [ "$(uname -m)" = "aarch64" ] || [ "$(uname -m)" = "arm64" ]; then \
            pip install --no-cache-dir "torch>=2.0,<3.0"; \
        else \
            pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch>=2.0,<3.0"; \
        fi; \
    fi

COPY requirements-api.txt ./
RUN if [ "$EMBEDDING_RUNTIME" = "onnx" ]; then \
        # Skip torch + sentence-transformers; they aren't loaded on the ONNX path.
        grep -v -E '^(sentence-transformers|transformers)\b' requirements-api.txt > /tmp/req.txt && \
        pip install --no-cache-dir -r /tmp/req.txt && \
        pip install --no-cache-dir "tokenizers>=0.15"; \
    else \
        pip install --no-cache-dir -r requirements-api.txt; \
    fi

# Bake assets needed at runtime.
ENV SCINCL_CACHE_DIR=/app/.model_cache
RUN if [ "$EMBEDDING_RUNTIME" = "pytorch" ]; then \
        # 420 MB SciNCL weights → ~1.5 GB image; saves cold-start download.
        python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('malteos/scincl', cache_folder='/app/.model_cache')"; \
    fi

ENV NLTK_DATA=/usr/share/nltk_data
RUN python -c "import nltk; nltk.download('stopwords', download_dir='/usr/share/nltk_data', quiet=True)"

# App code. scripts/ is included so maintenance ops are runnable via `fly ssh`.
COPY api/        ./api/
COPY scoring/    ./scoring/
COPY storage/    ./storage/
COPY llm/        ./llm/
COPY scripts/    ./scripts/
COPY config.py   ./
COPY config.yml  ./
COPY data/       ./data/
COPY ui/         ./ui/

# To ship the ONNX bundle (Phase B), run `python scripts/export_scincl_onnx.py`
# on a dev box, commit the resulting `models/` directory, and uncomment:
#
#   COPY models/ ./models/
#
# The line is intentionally absent today: with BuildKit, a COPY of a
# non-existent directory fails the build, and `models/` is gitignored until
# someone explicitly opts in to the ONNX runtime.

ENV POSTGRES_SSLMODE=require
ENV PORT=8080
ENV PYTHONUNBUFFERED=1

EXPOSE 8080
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
